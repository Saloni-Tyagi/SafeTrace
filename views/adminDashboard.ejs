<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<nav class="navbar">

    <div class="container">

        <span class="navbar-brand">
            🛡 SafeTrace Admin
        </span>

        <a href="/dashboard" class="btn btn-outline-light">
            Dashboard
        </a>

    </div>

</nav>

<div class="container mt-5">

    <h2 class="page-title">
        📊 Admin Dashboard
    </h2>

    <p class="page-subtitle">
        Manage complaints and monitor platform activity.
    </p>

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card p-4 text-center">

                <i class="bi bi-people-fill display-5 text-primary"></i>

                <h3 class="mt-3">
                    <%= users.length %>
                </h3>

                <p>Total Users</p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card p-4 text-center">

                <i class="bi bi-exclamation-triangle-fill display-5 text-danger"></i>

                <h3 class="mt-3">
                    <%= complaints.length %>
                </h3>

                <p>Total Complaints</p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card p-4 text-center">

                <i class="bi bi-bell-fill display-5 text-warning"></i>

                <h3 class="mt-3">
                    <%= alerts.length %>
                </h3>

                <p>SOS Alerts</p>

            </div>

        </div>

    </div>

    <h3 class="page-title mt-5">
        🚨 Vehicle Risk Profiles
    </h3>
    <p class="page-subtitle">
        Vehicles ranked by risk score based on complaint frequency, severity, and recency.
    </p>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Vehicle Number</th>
                    <th>Complaints</th>
                    <th>Risk Score</th>
                    <th>Risk Level</th>
                </tr>
            </thead>
            <tbody>
                <% if (riskProfiles.length === 0) { %>
                    <tr>
                        <td colspan="4" class="text-center text-muted">No complaints yet.</td>
                    </tr>
                <% } else { %>
                    <% riskProfiles.forEach(profile => { %>
                        <tr>
                            <td><strong><%= profile.vehicleNumber %></strong></td>
                            <td><%= profile.complaintCount %></td>
                            <td><%= profile.score %></td>
                            <td>
                                <% if (profile.label === "High") { %>
                                    <span class="badge bg-danger">High</span>
                                <% } else if (profile.label === "Medium") { %>
                                    <span class="badge bg-warning text-dark">Medium</span>
                                <% } else { %>
                                    <span class="badge bg-success">Low</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

</div>

</body>

</html>